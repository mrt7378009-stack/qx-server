# --- Quotex (a SEPARATE account, not your main one) ---
QUOTEX_EMAIL=you@example.com
QUOTEX_PASSWORD=your-password
# --- server ---
# QX_PAIRS=EURUSD,GBPUSD,USDMXN_otc      (default: 16 real + 15 OTC pairs)
# QX_API_KEYS=me:qx_key1,friend:qx_key2   (keys for hosts without a disk; or use: python qx_server.py key add NAME)
# QX_KEEP_HOURS=48                        (how long the server keeps candles)
# QX_SESSION_JSON={...}                   (content of session.json, for hosts without a disk)
# QX_PORT=8787
